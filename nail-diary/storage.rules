rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // naildiary 프로젝트 전용 Storage. 꿀팁 사진 업로드에 쓴다.
    // 로그인이 없는 앱이라 firestore.rules 와 같은 수준으로 개방했다:
    // 누구나 읽고 쓸 수 있고, 이미지 파일 · 8MB 이하만 업로드를 허용한다.
    match /nailDiary/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
