rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 이 파일은 fund-survey-bfd82 프로젝트에만 적용된다.
    // 커피노트는 lovehouse-b7440 의 Firestore 를 그대로 쓰므로 여기 규칙과 무관하다.

    // 자금수요조사 설정: 마감일·조사명은 누구나 고칠 수 있지만
    // 관리자 비밀번호 해시는 한 번 만들어지면 바꿀 수 없다.
    match /fundSurvey/config {
      allow read, create: if true;
      allow update: if !request.resource.data.diff(resource.data)
                        .affectedKeys().hasAny(['adminPwHash']);
      allow delete: if false;
    }

    // 프로젝트 명단.
    // 구버전이 쓰던 companies 도 남겨둬, 규칙을 먼저 올려도 앱이 멎지 않게 한다.
    match /fundSurvey/projects {
      allow read, write: if true;
    }
    match /fundSurvey/companies {
      allow read, write: if true;
    }

    // 프로젝트별 인출계획 응답 (문서 ID = 이메일::선정연도::프로젝트명)
    match /fundSurveyResponses/{projectId} {
      allow read, write: if true;
    }

    // 업체별 내년 신규 신청 계획 (문서 ID = 이메일)
    match /fundSurveyPlans/{email} {
      allow read, write: if true;
    }
  }
}
